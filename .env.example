#Binance API credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true

#Trading settings
EXCHANGE_MODE=SIMULATION # Options: SIMULATION, LIVE, PAPER
TIMEFRAME=5m
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

#Telegram Bot credentials
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

#Trading parameters
INITIAL_BALANCE=100
RISK_PER_TRADE=0.01
CAPITAL_ALLOCATION=1
MAX_OPEN_TRADES=3

#Backtest
SQLITE_PATH=./data/trading.sqlite
# Optional override, otherwise the first symbol from SYMBOLS is used:
# BACKTEST_SYMBOL=BTCUSDT
# Optional override, otherwise TIMEFRAME is used:
# BACKTEST_INTERVAL=1h
# HTF — higher timeframe, загружается для тех же монет и диапазона (по умолчанию 4h)
HTF_TIMEFRAME=4h
BACKTEST_USE_TESTNET=false
BACKTEST_RANGE_DAYS=7
# Optional explicit boundaries:
# BACKTEST_START=2024-01-01T00:00:00Z
# BACKTEST_END=2024-01-31T23:59:59Z

#Strategy settings
STRATEGY=RSI
