# ============================================
# Git Line Endings Normalization
# ============================================

# Автоматически обрабатывать окончания строк
* text=auto

# Source code - использовать LF (Unix-style)
*.ts     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.bash   text eol=lf
*.zsh    text eol=lf

# Web files
*.html   text eol=lf
*.htm    text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.less   text eol=lf

# Config files
*.env    text eol=lf
*.env.*  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.editorconfig  text eol=lf

# TypeScript/React specific
*.tsx    text eol=lf
*.jsx    text eol=lf
*.vue    text eol=lf

# Documentation
*.txt    text eol=lf
*.rst    text eol=lf
LICENSE  text eol=lf
README*  text eol=lf
CHANGELOG* text eol=lf

# ============================================
# Windows-specific files - использовать CRLF
# ============================================
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.sln    text eol=crlf

# ============================================
# Binary files (не обрабатывать как текст)
# ============================================
# Images
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    text

# Archives
*.zip    binary
*.tar    binary
*.tar.gz binary
*.rar    binary
*.7z     binary

# Documents
*.pdf    binary
*.doc    binary
*.docx   binary
*.xls    binary
*.xlsx   binary
*.ppt    binary
*.pptx   binary

# Database
*.db     binary
*.sqlite binary
*.sqlite3 binary

# Executables
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary

# ============================================
# Node.js specific
# ============================================
package.json text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf
pnpm-lock.yaml text eol=lf
npm-shrinkwrap.json text eol=lf

# ============================================
# Ensure consistent behavior
# ============================================
# Treat all files as text by default, but let git decide
* text=auto
